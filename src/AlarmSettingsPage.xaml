<UserControl
    x:Class="WinClock.AlarmSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Settings_AlarmPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            VerticalAlignment="Center"
            Text="預設鈴聲：" />
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="8,0,0,0"
            Orientation="Horizontal">
            <ComboBox
                x:Name="DefaultSoundComboBox"
                MinWidth="130"
                AutomationProperties.AutomationId="Settings_DefaultSoundComboBox"
                AutomationProperties.Name="預設鈴聲"
                SelectionChanged="Control_Changed" />
            <Button
                x:Name="PreviewButton"
                MinWidth="60"
                Margin="8,0,0,0"
                Padding="8,2"
                AutomationProperties.AutomationId="Settings_SoundPreviewButton"
                Click="PreviewButton_Click"
                Content="試聽" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,14,0,0"
            VerticalAlignment="Center"
            Text="音量：" />
        <DockPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="8,14,0,0">
            <TextBlock
                x:Name="VolumeText"
                Width="40"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Settings_VolumeText"
                DockPanel.Dock="Right"
                TextAlignment="Right" />
            <Slider
                x:Name="VolumeSlider"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Settings_VolumeSlider"
                AutomationProperties.Name="音量"
                IsSnapToTickEnabled="True"
                LargeChange="10"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                TickFrequency="1"
                ValueChanged="VolumeSlider_ValueChanged" />
        </DockPanel>

        <TextBlock
            Grid.Row="2"
            Margin="0,14,0,0"
            VerticalAlignment="Center"
            Text="貪睡：" />
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Margin="8,14,0,0"
            Orientation="Horizontal">
            <ComboBox
                x:Name="SnoozeComboBox"
                MinWidth="70"
                AutomationProperties.AutomationId="Settings_SnoozeMinutesComboBox"
                AutomationProperties.Name="貪睡分鐘數"
                SelectionChanged="Control_Changed" />
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Text="分鐘" />
        </StackPanel>
    </Grid>
</UserControl>

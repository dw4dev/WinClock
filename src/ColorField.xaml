<UserControl
    x:Class="WinClock.ColorField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBox
            x:Name="HexTextBox"
            Width="80"
            VerticalContentAlignment="Center"
            LostFocus="HexTextBox_LostFocus"
            MaxLength="7"
            TextChanged="HexTextBox_TextChanged" />
        <Button
            x:Name="PickButton"
            Width="28"
            Margin="6,0,0,0"
            Padding="3"
            Click="PickButton_Click"
            ToolTip="選擇顏色">
            <Border
                x:Name="Swatch"
                BorderBrush="Gray"
                BorderThickness="1" />
        </Button>
    </StackPanel>
</UserControl>

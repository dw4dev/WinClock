<Window
    x:Class="WinClock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dw="http://schemas.dwtoolkit/wpf"
    xmlns:local="clr-namespace:WinClock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="桌面時鐘"
    Width="330"
    dw:WindowPersistence.Key="Main"
    AutomationProperties.AutomationId="Main_Window"
    MinWidth="330"
    MaxWidth="800"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="CanResize"
    SizeChanged="Window_SizeChanged"
    SizeToContent="Height"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  主題資源定義 (將在後台動態更新)  -->
        <SolidColorBrush x:Key="WindowBackground" Color="#CC1E1E24" />
        <SolidColorBrush x:Key="WindowBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A5B5" />
        <SolidColorBrush x:Key="IconForeground" Color="#D0D3DB" />
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="ButtonPressedBackground" Color="#30FFFFFF" />

        <!--  Thumb 自定義樣式  -->
        <Style x:Key="ResizeGripStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Canvas
                            Width="12"
                            Height="12"
                            Background="Transparent">
                            <Ellipse
                                Canvas.Left="2"
                                Canvas.Top="2"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5"
                                Visibility="Hidden" />
                            <Ellipse
                                Canvas.Left="6"
                                Canvas.Top="2"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5"
                                Visibility="Hidden" />
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="2"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5" />

                            <Ellipse
                                Canvas.Left="2"
                                Canvas.Top="6"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5"
                                Visibility="Hidden" />
                            <Ellipse
                                Canvas.Left="6"
                                Canvas.Top="6"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5" />
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="6"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5" />

                            <Ellipse
                                Canvas.Left="2"
                                Canvas.Top="10"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5" />
                            <Ellipse
                                Canvas.Left="6"
                                Canvas.Top="10"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5" />
                            <Ellipse
                                Canvas.Left="10"
                                Canvas.Top="10"
                                Width="2"
                                Height="2"
                                Fill="{DynamicResource TextSecondary}"
                                Opacity="0.5" />
                        </Canvas>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="SizeNWSE" />
        </Style>

        <!--  工具列按鈕通用樣式  -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  關閉按鈕專用樣式  -->
        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource TitleBarButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  生效中鬧鐘按鈕的底色 (將在後台依主題更新)  -->
        <SolidColorBrush x:Key="ActiveAlarmBackground" Color="#40EF4444" />

        <!--  鬧鐘按鈕與「+」按鈕：比一般工具列按鈕窄，最小寬度 330 時放得下 5 個鬧鐘  -->
        <Style
            x:Key="AlarmButtonStyle"
            BasedOn="{StaticResource TitleBarButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Margin" Value="1,2" />
        </Style>
    </Window.Resources>

    <Border
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource WindowBorder}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  工具列區域  -->
            <Border Grid.Row="0" Margin="6,6,6,0">
                <DockPanel LastChildFill="False">
                    <!--  左側控制按鈕  -->
                    <Button
                        x:Name="btnPinTop"
                        AutomationProperties.AutomationId="Main_PinButton"
                        AutomationProperties.Name="永遠在最上層"
                        Click="btnPinTop_Click"
                        DockPanel.Dock="Left"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="將視窗固定在最上層">
                        <Path
                            Width="12"
                            Height="12"
                            Data="F1 M 12,2 A 2,2 0 0,1 14,4 V 9.58 L 17,13 V 15 H 13 V 21 L 12,22 L 11,21 V 15 H 7 V 13 L 10,9.58 V 4 A 2,2 0 0,1 12,2 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>

                    <!--  生效中的鬧鐘：每個鬧鐘一個按鈕（最多 5 個），由 MainWindow.alarmItems 提供  -->
                    <ItemsControl
                        x:Name="AlarmButtons"
                        DockPanel.Dock="Left"
                        Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AlarmItem}">
                                <Button
                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    Background="{DynamicResource ActiveAlarmBackground}"
                                    Click="btnAlarm_Click"
                                    Style="{StaticResource AlarmButtonStyle}"
                                    ToolTip="{Binding ToolTipText}"
                                    ToolTipOpening="btnAlarm_ToolTipOpening">
                                    <Grid>
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4 M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5 M2.1,5.1L5.9,2.1L7.1,3.7L3.3,6.7L2.1,5.1 M21.9,5.1L20.7,6.7L16.9,3.7L18.1,2.1L21.9,5.1Z"
                                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Margin="0,1,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="7.5"
                                            FontWeight="Bold"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="{Binding Number}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  新增鬧鐘（已達上限時隱藏）  -->
                    <Button
                        x:Name="btnAddAlarm"
                        AutomationProperties.AutomationId="Main_AddAlarmButton"
                        AutomationProperties.Name="新增鬧鐘"
                        Click="btnAddAlarm_Click"
                        DockPanel.Dock="Left"
                        Style="{StaticResource AlarmButtonStyle}"
                        ToolTip="新增鬧鐘">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>

                    <!--  右側控制按鈕  -->
                    <Button
                        x:Name="btnClose"
                        Click="btnClose_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="關閉視窗">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>

                    <Button
                        x:Name="btnMinimize"
                        AutomationProperties.AutomationId="Main_MinimizeButton"
                        AutomationProperties.Name="縮到系統匣"
                        Click="btnMinimize_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="縮到系統匣">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M4 11h16v2H4z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>

                    <Button
                        x:Name="btnSettings"
                        AutomationProperties.AutomationId="Main_SettingsButton"
                        AutomationProperties.Name="設定"
                        Click="btnSettings_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="設定">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>

                    <Button
                        x:Name="btnThemeToggle"
                        Click="btnThemeToggle_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="切換主題">
                        <Path
                            x:Name="themeIcon"
                            Width="12"
                            Height="12"
                            Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </DockPanel>
            </Border>

            <!--  時間顯示區域  -->
            <StackPanel
                Grid.Row="1"
                Margin="16,8,16,16"
                Orientation="Vertical">
                <!--  日期文字  -->
                <TextBlock
                    x:Name="DateText"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Left"
                    d:Text="2024/02/10 (九)"
                    FontFamily="Segoe UI, Microsoft JhengHei UI"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}" />

                <!--  農曆與節氣  -->
                <StackPanel
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="LunarDateText"
                        VerticalAlignment="Center"
                        d:Text="農曆 臘月初六"
                        FontFamily="Segoe UI, Microsoft JhengHei UI"
                        FontSize="16"
                        FontWeight="Normal"
                        Foreground="{DynamicResource TextSecondary}" />

                    <Border
                        x:Name="LunarTerm"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#3310B981"
                        CornerRadius="4">
                        <TextBlock
                            x:Name="LunarTermText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Text="立春"
                            FontFamily="Segoe UI, Microsoft JhengHei UI"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#34D399" />
                    </Border>
                </StackPanel>

                <!--  時間主文字  -->
                <TextBlock
                    x:Name="TimeText"
                    AutomationProperties.AutomationId="Main_TimeText"
                    Margin="0,-10,0,0"
                    HorizontalAlignment="Center"
                    d:Text="02:10:06"
                    FontFamily="Segoe UI, Microsoft JhengHei UI"
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <!--  版本資訊 (左下角)  -->
            <TextBlock
                x:Name="VersionText"
                Grid.Row="1"
                Margin="10,0,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontFamily="Segoe UI, Microsoft JhengHei UI"
                FontSize="10"
                Foreground="{DynamicResource TextSecondary}"
                Opacity="0.8" />

            <!--  視窗拖曳調整大小的把手 (對齊内容列右下角)  -->
            <Thumb
                x:Name="ResizeThumb"
                Grid.Row="1"
                Width="12"
                Height="12"
                Margin="0,0,3,3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                DragDelta="ResizeThumb_DragDelta"
                Style="{StaticResource ResizeGripStyle}" />
        </Grid>
    </Border>
</Window>


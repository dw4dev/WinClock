<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WinClock">

    <!--  設定視窗的現代化樣式（M-002）。只合併到設定類視窗，不影響主視窗。  -->

    <local:ScaleConverter x:Key="Scale" />

    <SolidColorBrush x:Key="S.WindowBg" Color="#F3F4F6" />
    <SolidColorBrush x:Key="S.CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="S.Border" Color="#D9DCE1" />
    <SolidColorBrush x:Key="S.BorderHover" Color="#AEB4BD" />
    <SolidColorBrush x:Key="S.Text" Color="#1F2328" />
    <SolidColorBrush x:Key="S.TextDisabled" Color="#A0A5AD" />
    <SolidColorBrush x:Key="S.Accent" Color="#2E7D6B" />
    <SolidColorBrush x:Key="S.AccentHover" Color="#3A9580" />
    <SolidColorBrush x:Key="S.AccentPressed" Color="#24634F" />
    <SolidColorBrush x:Key="S.AccentSoft" Color="#E3F1ED" />
    <SolidColorBrush x:Key="S.ControlHover" Color="#EEF0F3" />
    <SolidColorBrush x:Key="S.ControlPressed" Color="#E2E5E9" />
    <CornerRadius x:Key="S.Radius">6</CornerRadius>

    <!--  按鈕：圓角；IsDefault 的按鈕用強調色  -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Background" Value="{StaticResource S.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource S.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource S.Radius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource S.ControlHover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource S.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource S.ControlPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource S.Accent}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource S.AccentHover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource S.AccentPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  勾選框：方框大小 = 字型大小 × 1.3，圓角，勾選時強調色底＋白勾  -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="box"
                            Width="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=1.3}"
                            Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=1.3}"
                            VerticalAlignment="Center"
                            Background="{StaticResource S.CardBg}"
                            BorderBrush="{StaticResource S.BorderHover}"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <Viewbox Margin="3">
                                <Path
                                    x:Name="mark"
                                    Data="M 1,5 L 4,8 L 9,2"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8"
                                    Visibility="Collapsed" />
                            </Viewbox>
                        </Border>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource S.Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  選項鈕：圓圈大小跟隨字型大小  -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=1.3}"
                            Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=1.3}"
                            VerticalAlignment="Center">
                            <Ellipse
                                x:Name="ring"
                                Fill="{StaticResource S.CardBg}"
                                Stroke="{StaticResource S.BorderHover}"
                                StrokeThickness="1.5" />
                            <Ellipse
                                x:Name="dot"
                                Margin="4"
                                Fill="{StaticResource S.Accent}"
                                Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource S.Accent}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  文字框：圓角、聚焦時強調色框  -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource S.Text}" />
        <Setter Property="Background" Value="{StaticResource S.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource S.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource S.Radius}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource S.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource S.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource S.TextDisabled}" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource S.WindowBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  左側導覽清單：無框，項目圓角，選取時淡強調色底＋左側色條  -->
    <Style x:Key="S.NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="Foreground" Value="{StaticResource S.Text}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="bd"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource S.Radius}">
                                    <Grid>
                                        <Border
                                            x:Name="bar"
                                            Width="3"
                                            Margin="0,8"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource S.Accent}"
                                            CornerRadius="2"
                                            Visibility="Collapsed" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource S.ControlPressed}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource S.AccentSoft}" />
                                        <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

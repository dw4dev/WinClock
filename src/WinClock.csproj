<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Images\WinClock.ico</ApplicationIcon>
    <!-- 編譯輸出到 repo 根目錄的 build\<組態>\（例：build\Debug\WinClock.exe）；發佈另由 tools\release.bat 輸出到 build\publish。 -->
    <OutputPath>$(MSBuildThisFileDirectory)..\build\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    共用框架 DWToolkit.Wpf（視窗位置／尺寸／擴充狀態的持久化）。
    DWToolkit 與 WinClock 平行放置；編譯 WinClock 前，先執行 ..\DWToolkit\tools\build.bat 產生 dist。
  -->
  <Import Project="..\..\DWToolkit\dist\DWToolkit.Wpf.props" />

  <ItemGroup>
    <None Remove="Images\alarm.png" />
    <None Remove="Images\close.png" />
    <None Remove="Images\minimize.png" />
    <None Remove="Images\pin.png" />
    <None Remove="Images\play-button.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\WinClock.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.6.143" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\alarm.png" />
    <Resource Include="Images\close.png" />
    <Resource Include="Images\minimize.png" />
    <Resource Include="Images\pin.png" />
    <Resource Include="Images\play-button.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Sounds\alarm1.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\alarm2.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\alarm3.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\alarm4.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<UserControl
    x:Class="WinClock.ColorSchemeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WinClock">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="背景顏色" />
        <local:ColorField
            x:Name="BackgroundField"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            ValueChanged="Control_Changed" />

        <CheckBox
            x:Name="GradientCheckBox"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,8,0,0"
            Checked="Control_Changed"
            Content="使用漸層"
            Unchecked="Control_Changed" />

        <TextBlock
            Grid.Row="2"
            Margin="22,8,10,0"
            VerticalAlignment="Center"
            IsEnabled="{Binding IsChecked, ElementName=GradientCheckBox}"
            Text="漸層第二色" />
        <local:ColorField
            x:Name="Background2Field"
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            IsEnabled="{Binding IsChecked, ElementName=GradientCheckBox}"
            ValueChanged="Control_Changed" />

        <TextBlock
            Grid.Row="3"
            Margin="22,8,10,0"
            VerticalAlignment="Center"
            IsEnabled="{Binding IsChecked, ElementName=GradientCheckBox}"
            Text="漸層角度" />
        <Slider
            x:Name="AngleSlider"
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            IsEnabled="{Binding IsChecked, ElementName=GradientCheckBox}"
            IsSnapToTickEnabled="True"
            LargeChange="15"
            Maximum="360"
            Minimum="0"
            SmallChange="1"
            TickFrequency="1"
            ValueChanged="Slider_ValueChanged" />
        <TextBlock
            x:Name="AngleText"
            Grid.Row="3"
            Grid.Column="2"
            Width="44"
            Margin="8,8,0,0"
            VerticalAlignment="Center"
            TextAlignment="Right" />

        <TextBlock
            Grid.Row="4"
            Margin="0,8,10,0"
            VerticalAlignment="Center"
            Text="文字顏色" />
        <local:ColorField
            x:Name="TextField"
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            ValueChanged="Control_Changed" />

        <TextBlock
            Grid.Row="5"
            Margin="0,8,10,0"
            VerticalAlignment="Center"
            Text="不透明度" />
        <Slider
            x:Name="OpacitySlider"
            Grid.Row="5"
            Grid.Column="1"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            LargeChange="10"
            Maximum="100"
            Minimum="0"
            SmallChange="1"
            ValueChanged="Slider_ValueChanged" />
        <TextBlock
            x:Name="OpacityText"
            Grid.Row="5"
            Grid.Column="2"
            Width="44"
            Margin="8,8,0,0"
            VerticalAlignment="Center"
            TextAlignment="Right" />
    </Grid>
</UserControl>

<UserControl
    x:Class="WinClock.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WinClock"
    AutomationProperties.AutomationId="Settings_AppearancePage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <TextBlock Text="主題：" />
            <StackPanel Margin="22,4,0,0" Orientation="Horizontal">
                <RadioButton
                    x:Name="ThemeLightRadio"
                    AutomationProperties.AutomationId="Settings_ThemeLightRadioButton"
                    Checked="ThemeRadio_Checked"
                    Content="明亮"
                    GroupName="ThemeMode" />
                <RadioButton
                    x:Name="ThemeDarkRadio"
                    Margin="16,0,0,0"
                    AutomationProperties.AutomationId="Settings_ThemeDarkRadioButton"
                    Checked="ThemeRadio_Checked"
                    Content="暗色"
                    GroupName="ThemeMode" />
                <RadioButton
                    x:Name="ThemeFollowRadio"
                    Margin="16,0,0,0"
                    AutomationProperties.AutomationId="Settings_ThemeFollowWindowsRadioButton"
                    Checked="ThemeRadio_Checked"
                    Content="跟隨 Windows"
                    GroupName="ThemeMode" />
            </StackPanel>

            <GroupBox
                Margin="0,14,0,0"
                Padding="8"
                AutomationProperties.AutomationId="Settings_LightSchemeGroup"
                Header="明亮">
                <local:ColorSchemeEditor x:Name="LightEditor" />
            </GroupBox>
            <GroupBox
                Margin="0,10,0,0"
                Padding="8"
                AutomationProperties.AutomationId="Settings_DarkSchemeGroup"
                Header="暗色">
                <local:ColorSchemeEditor x:Name="DarkEditor" />
            </GroupBox>
            <GroupBox
                Margin="0,10,0,0"
                Padding="8"
                AutomationProperties.AutomationId="Settings_FontGroup"
                Header="字型">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="中文字型" />
                    <ComboBox
                        x:Name="ChineseFontCombo"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="Settings_ChineseFontComboBox"
                        AutomationProperties.Name="中文字型"
                        SelectionChanged="Font_Changed" />
                    <ComboBox
                        x:Name="ChineseWeightCombo"
                        Grid.Column="2"
                        Width="70"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="Settings_ChineseFontWeightComboBox"
                        AutomationProperties.Name="中文字型粗細"
                        SelectionChanged="Font_Changed" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,8,10,0"
                        VerticalAlignment="Center"
                        Text="數字字型" />
                    <ComboBox
                        x:Name="DigitFontCombo"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        AutomationProperties.AutomationId="Settings_DigitFontComboBox"
                        AutomationProperties.Name="數字字型"
                        SelectionChanged="Font_Changed" />
                    <ComboBox
                        x:Name="DigitWeightCombo"
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="70"
                        Margin="6,8,0,0"
                        AutomationProperties.AutomationId="Settings_DigitFontWeightComboBox"
                        AutomationProperties.Name="數字字型粗細"
                        SelectionChanged="Font_Changed" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,10,0"
                        VerticalAlignment="Center"
                        Text="縮放比例" />
                    <Slider
                        x:Name="FontScaleSlider"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Settings_FontScaleSlider"
                        AutomationProperties.Name="字型縮放比例"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        SmallChange="5"
                        TickFrequency="5"
                        ValueChanged="FontScaleSlider_ValueChanged" />
                    <TextBlock
                        x:Name="FontScaleText"
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="6,8,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Settings_FontScaleText" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>

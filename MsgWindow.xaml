<Window
    x:Class="WinClock.MsgWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WinClock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="訊息視窗"
    Width="420"
    AllowsTransparency="True"
    Background="Transparent"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <!-- 主題資源定義 (將在後台動態更新) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#E61E1E24" />
        <SolidColorBrush x:Key="WindowBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A5B5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#81BFDA" />
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#25FFFFFF" />
        <SolidColorBrush x:Key="ButtonPressedBackground" Color="#40FFFFFF" />

        <!-- 扁平按鈕樣式 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 關閉圖示按鈕樣式 -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource WindowBorder}"
        BorderThickness="1"
        CornerRadius="16">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 標頭 -->
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />    <!-- 內容 -->
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" /> <!-- 按鈕 -->
            </Grid.RowDefinitions>

            <!-- 標頭 -->
            <Grid Grid.Row="0">
                <TextBlock
                    x:Name="txtTitle"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding HeaderText, TargetNullValue=訊息視窗, FallbackValue=訊息視窗}" />

                <Button
                    x:Name="btnHeaderClose"
                    Click="btnClose_Click"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IconButtonStyle}">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                          Fill="{DynamicResource IconForeground}" 
                          Width="9" Height="9" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 內容區 -->
            <ScrollViewer
                Grid.Row="2"
                MaxHeight="200"
                VerticalScrollBarVisibility="Auto">
                <Border MinHeight="60" Padding="4">
                    <TextBlock
                        x:Name="txtMessage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Microsoft JhengHei UI"
                        FontSize="18"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding MessageText, TargetNullValue=無訊息內容, FallbackValue=無訊息內容}"
                        TextWrapping="Wrap" />
                </Border>
            </ScrollViewer>

            <!-- 關閉按鈕 -->
            <Button
                x:Name="btnClose"
                Grid.Row="4"
                Width="120"
                Height="32"
                HorizontalAlignment="Center"
                Content="關 閉"
                Click="btnClose_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MsgWindow}, Path=IsDarkTheme}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#1E293B" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MsgWindow}, Path=IsDarkTheme}" Value="False">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>

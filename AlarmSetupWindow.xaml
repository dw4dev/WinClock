<Window
    x:Class="WinClock.AlarmSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WinClock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="鬧鐘設定"
    Width="330"
    AllowsTransparency="True"
    Background="Transparent"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  主題資源定義 (將在後台動態更新)  -->
        <SolidColorBrush x:Key="WindowBackground" Color="#E6202940" />
        <SolidColorBrush x:Key="WindowBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A5B5" />
        <SolidColorBrush x:Key="ControlBackground" Color="#2A2A32" />
        <SolidColorBrush x:Key="ControlBorder" Color="#44FFFFFF" />
        <SolidColorBrush x:Key="ControlForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#25FFFFFF" />
        <SolidColorBrush x:Key="ButtonPressedBackground" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#81BFDA" />

        <!--  扁平按鈕樣式  -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  關閉按鈕樣式  -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ComboBox 簡約樣式微調  -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  DatePicker 簡約樣式微調  -->
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Height" Value="28" />
        </Style>

        <!--  TextBox 樣式  -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="false"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  CheckBox 樣式  -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource WindowBorder}"
        BorderThickness="1"
        CornerRadius="16"
        TextElement.FontSize="16">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="47*" />
                <ColumnDefinition Width="249*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  標頭  -->
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <!--  內容  -->
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <!--  按鈕  -->
            </Grid.RowDefinitions>

            <!--  標頭  -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="設定鬧鐘" />

                <Button
                    x:Name="btnHeaderClose"
                    HorizontalAlignment="Right"
                    Click="btnCancel_Click"
                    Style="{StaticResource IconButtonStyle}">
                    <Path
                        Width="9"
                        Height="9"
                        Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                        Fill="{DynamicResource IconForeground}"
                        Stretch="Uniform" />
                </Button>
            </Grid>

            <!--  內容區  -->
            <StackPanel
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Orientation="Vertical">
                <!--  日期選擇  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="日期：" />
                    <DatePicker
                        x:Name="AlarmDatePicker"
                        Grid.Column="1"
                        SelectedDate="{Binding MyAlarmCfg.AlarmDate, Mode=TwoWay}" />
                </Grid>

                <!--  時間選擇  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="時間：" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox
                            x:Name="cmbHour"
                            Width="70"
                            IsEditable="True"
                            SelectedValue="{Binding MyAlarmCfg.Hour, Mode=TwoWay}" />
                        <TextBlock
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="：" />
                        <ComboBox
                            x:Name="cmbMinute"
                            Width="70"
                            IsEditable="True"
                            SelectedValue="{Binding MyAlarmCfg.Minute, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!--  音效設定  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="chkPlaySound"
                        Grid.Column="0"
                        Content="播放音效"
                        IsChecked="{Binding MyAlarmCfg.IsPlaySound, Mode=TwoWay}" />
                    <ComboBox
                        x:Name="cmbSound"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        IsEditable="False"
                        IsEnabled="{Binding ElementName=chkPlaySound, Path=IsChecked}"
                        SelectedValue="{Binding MyAlarmCfg.SoundName, Mode=TwoWay}" />
                    <Button
                        x:Name="btnPlay"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="btnPlay_Click"
                        IsEnabled="{Binding MyAlarmCfg.IsPlaySound}"
                        ToolTip="播放試聽">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:AlarmSetupWindow}, Path=IsPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!--  播放向量圖示  -->
                        <Path
                            Width="12"
                            Height="12"
                            Data="M8 5v14l11-7z"
                            Fill="{DynamicResource IconForeground}"
                            Stretch="Uniform" />
                    </Button>
                </Grid>

                <!--  文字訊息設定  -->
                <StackPanel Orientation="Vertical">
                    <CheckBox
                        x:Name="chkShowMsg"
                        Content="顯示文字"
                        IsChecked="{Binding MyAlarmCfg.IsShowMsg, Mode=TwoWay}" />
                    <TextBox
                        x:Name="txtMsg"
                        Margin="0,6,0,0"
                        IsEnabled="{Binding ElementName=chkShowMsg, Path=IsChecked}"
                        Text="{Binding MyAlarmCfg.MsgText, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>

            <!--  底部動作按鈕  -->
            <Grid
                Grid.Row="3"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                MinHeight="30"
                Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  清除鬧鐘  -->
                <Button
                    x:Name="btnRemove"
                    Grid.Column="0"
                    Width="76"
                    Background="#33EF4444"
                    BorderBrush="#66EF4444"
                    Click="btnRemove_Click"
                    Content="清除鬧鐘"
                    Foreground="#FFFCA5A5"
                    IsEnabled="{Binding MyAlarmCfg.IsEnabled}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource ModernButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <!--  當為淺色主題時，清除按鈕的顏色優化  -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:AlarmSetupWindow}, Path=IsDarkTheme}" Value="False">
                                    <Setter Property="Background" Value="#FFE8E8" />
                                    <Setter Property="Foreground" Value="#DC2626" />
                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!--  取消與確定  -->
                <Button
                    x:Name="btnCancel"
                    Grid.Column="2"
                    Width="60"
                    Click="btnCancel_Click"
                    Content="取消"
                    Style="{StaticResource ModernButtonStyle}" />

                <Button
                    x:Name="btnOK"
                    Grid.Column="4"
                    Width="60"
                    Background="{DynamicResource AccentBrush}"
                    BorderThickness="0"
                    Click="btnOK_Click"
                    Content="確定"
                    Foreground="#1E293B">
                    <Button.Style>
                        <Style BasedOn="{StaticResource ModernButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:AlarmSetupWindow}, Path=IsDarkTheme}" Value="True">
                                    <Setter Property="Foreground" Value="#1E293B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:AlarmSetupWindow}, Path=IsDarkTheme}" Value="False">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#0F172A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
